program BinaryOperationCircuitBreakout;

function foo(): boolean;
begin
  writeln('foo called');
  foo := false;
end;

function bar(): boolean;
begin
  writeln('bar called');
  bar := true;
end;

begin
  if foo and bar then
    writeln('e esse não deve!')
  else
    writeln('mas esse deve!');  { "bar called" deve ser impresso }
end.
