use crate::lexer::Token;
use crate::ast::*;

grammar;

extern {
    type Location = usize;
    type Error = String;

    enum Token {
        "program" => Token::Program,
        "var" => Token::Var,
        "const" => Token::Const,
        "type" => Token::Type,
        "label" => Token::Label,
        "procedure" => Token::Procedure,
        "function" => Token::Function,
        "begin" => Token::Begin,
        "end" => Token::End,
        "if" => Token::If,
        "then" => Token::Then,
        "else" => Token::Else,
        "while" => Token::While,
        "do" => Token::Do,
        "for" => Token::For,
        "to" => Token::To,
        "downto" => Token::Downto,
        "repeat" => Token::Repeat,
        "until" => Token::Until,
        "case" => Token::Case,
        "of" => Token::Of,
        "goto" => Token::Goto,
        "array" => Token::Array,
        "record" => Token::Record,
        "set" => Token::Set,
        "in" => Token::In,
        "file" => Token::File,
        "integer" => Token::Integer,
        "real" => Token::Real,
        "boolean" => Token::Boolean,
        "string" => Token::String,
        "char" => Token::Char,
        "not" => Token::Not,
        "and" => Token::And,
        "or" => Token::Or,
        "div" => Token::Div,
        "mod" => Token::Mod,
        "write" => Token::Write,
        "writeln" => Token::Writeln,
        "read" => Token::Read,
        "readln" => Token::Readln,
        "Chr" => Token::Chr,
        "nil" => Token::Nil,
        "with" => Token::With,
        "forward" => Token::Forward,
        "packed" => Token::Packed,
        "unit" => Token::Unit,
        "interface" => Token::Interface,
        "implementation" => Token::Implementation,
        "uses" => Token::Uses,
        "initialization" => Token::Initialization,
        "external" => Token::External,

        "+" => Token::Plus,
        "-" => Token::Minus,
        "/" => Token::Slash,
        "*" => Token::Star,
        "(" => Token::LParen,
        ")" => Token::RParen,
        "{" => Token::LBrace,
        "}" => Token::RBrace,
        "[" => Token::LBracket,
        "]" => Token::RBracket,
        ">=" => Token::Gte,
        "<=" => Token::Lte,
        ">" => Token::Gt,
        "<" => Token::Lt,
        "=" => Token::Eq,
        "<>" => Token::Neq,
        ":=" => Token::Assign,
        "," => Token::Comma,
        ":" => Token::Colon,
        ";" => Token::Semicolon,
        ".." => Token::DotDot,
        "." => Token::Dot,
        "^" => Token::Caret,

        "boolean_lit" => Token::BooleanLiteral(<bool>),
        "char_lit" => Token::CharLiteral(<char>),
        "char_code" => Token::CharCode(<char>),
        "int_lit" => Token::IntegerLiteral(<i64>),
        "real_lit" => Token::RealLiteral(<f64>),
        "identifier" => Token::Identifier(<String>),
        "string_lit" => Token::StringLiteral(<String>),
    }
}

pub CompilationUnit: CompilationUnit = {
    Program => CompilationUnit::Program(<>),
    Unit => CompilationUnit::Unit(<>),
};

pub Program: Program = {
    <l:@L> "program" <name:"identifier"> <heading:HeadingOpt> ";" <uses:UsesClause?> <block:Block> "." <r:@R> => Program {
        span: Span::new(l, r),
        name,
        heading,
        uses,
        block,
    }
};

pub Unit: Unit = {
    <l:@L> "unit" <name:"identifier"> ";"
    "interface" <interface:InterfaceSection>
    "implementation" <implementation:ImplementationSection>
    <initialization:Initialization?>
    "end" "." <r:@R> => Unit {
        span: Span::new(l, r),
        name,
        interface,
        implementation,
        initialization,
    }
};

InterfaceSection: InterfaceSection = {
    <l:@L> <uses:UsesClause?>
    <constants:(ConstDecl ";")?>
    <types:(TypeDecl ";")?>
    <variables:(VarDecl ";")?>
    <headers:(ProcFuncHeaderList ";")?> <r:@R> => InterfaceSection {
        span: Span::new(l, r),
        uses,
        constants: constants.map(|(c, _)| c),
        types: types.map(|(t, _)| t),
        variables: variables.map(|(v, _)| v),
        headers: headers.map(|(p, _)| p),
    }
};

ImplementationSection: ImplementationSection = {
    <l:@L> <uses:UsesClause?>
    <constants:(ConstDecl ";")?>
    <types:(TypeDecl ";")?>
    <variables:(VarDecl ";")?>
    <bodies:(ProcFuncDecl ";")?> <r:@R> => ImplementationSection {
        span: Span::new(l, r),
        uses,
        constants: constants.map(|(c, _)| c),
        types: types.map(|(t, _)| t),
        variables: variables.map(|(v, _)| v),
        bodies: bodies.map(|(p, _)| p),
    }
};

UsesClause: Vec<String> = {
    "uses" <ids:IdentifierList> ";" => ids,
};

Initialization: Vec<Stmt> = {
    "initialization" <list:StmtList> => list,
};

HeadingOpt: Option<Vec<String>> = {
    "(" <ids:IdentifierList> ")" => Some(ids),
    () => None,
};

IdentifierList: Vec<String> = {
    <id:"identifier"> => vec![id],
    <mut list:IdentifierList> "," <id:"identifier"> => {
        list.push(id);
        list
    }
};

Block: Block = {
    <l:@L> <labels:(LabelDecl ";")?>
    <constants:(ConstDecl ";")?>
    <types:(TypeDecl ";")?>
    <variables:(VarDecl ";")?>
    <procs:(ProcFuncDecl ";")?>
    <stmts:CompoundStmtInner> <r:@R> => {
        Block {
            span: Span::new(l, r),
            labels: labels.map(|(l, _)| l),
            constants: constants.map(|(c, _)| c),
            types: types.map(|(t, _)| t),
            variables: variables.map(|(v, _)| v),
            procedures_functions: procs.map(|(p, _)| p),
            statements: stmts,
        }
    }
};

LabelDecl: Vec<i64> = {
    "label" <n:"int_lit"> => vec![n],
    <mut list:LabelDecl> "," <n:"int_lit"> => {
        list.push(n);
        list
    }
};

ConstDecl: Vec<ConstDecl> = {
    "const" <c:ConstItem> => vec![c],
    <mut list:ConstDecl> ";" <c:ConstItem> => {
        list.push(c);
        list
    }
};

ConstItem: ConstDecl = {
    <l:@L> <id:"identifier"> "=" <val:Constant> <r:@R> => ConstDecl { span: Span::new(l, r), name: id, value: val },
};

TypeDecl: Vec<TypeDecl> = {
    "type" <t:TypeItem> => vec![t],
    <mut list:TypeDecl> ";" <t:TypeItem> => {
        list.push(t);
        list
    }
};

TypeItem: TypeDecl = {
    <l:@L> <id:"identifier"> "=" <te:TypeExpr> <r:@R> => TypeDecl { span: Span::new(l, r), name: id, type_expr: te },
};

VarDecl: Vec<VarDecl> = {
    "var" <v:VarItem> => vec![v],
    <mut list:VarDecl> ";" <v:VarItem> => {
        list.push(v);
        list
    }
};

VarItem: VarDecl = {
    <l:@L> <ids:IdentifierList> ":" <te:TypeExpr> <r:@R> => VarDecl { span: Span::new(l, r), ids, type_expr: te },
};

ProcFuncHeaderList: Vec<ProcFuncDecl> = {
    <decl:ProcFuncHeader> => vec![decl],
    <mut list:ProcFuncHeaderList> ";" <decl:ProcFuncHeader> => {
        list.push(decl);
        list
    }
};

ProcFuncHeader: ProcFuncDecl = {
    <l:@L> "procedure" <name:"identifier"> <params:Parameters?> <r:@R> => {
        ProcFuncDecl::Procedure { span: Span::new(l, r), name, params, block_or_forward: BlockOrForward::Forward }
    },
    <l:@L> "function" <name:"identifier"> <params:Parameters?> ":" <rt:TypeName> <r:@R> => {
        ProcFuncDecl::Function { span: Span::new(l, r), name, params, return_type: rt, block_or_forward: BlockOrForward::Forward }
    }
};

ProcFuncDecl: Vec<ProcFuncDecl> = {
    <decl:ProcOrFunc> => vec![decl],
    <mut list:ProcFuncDecl> ";" <decl:ProcOrFunc> => {
        list.push(decl);
        list
    }
};

ProcOrFunc: ProcFuncDecl = {
    <l:@L> "procedure" <name:"identifier"> <params:Parameters?> ";" <block:BlockOrExternal> <r:@R> => {
        ProcFuncDecl::Procedure { span: Span::new(l, r), name, params, block_or_forward: block }
    },
    <l:@L> "function" <name:"identifier"> <params:Parameters?> ":" <rt:TypeName> ";" <block:BlockOrExternal> <r:@R> => {
        ProcFuncDecl::Function { span: Span::new(l, r), name, params, return_type: rt, block_or_forward: block }
    }
};

BlockOrExternal: BlockOrForward = {
    "forward" => BlockOrForward::Forward,
    "external" => BlockOrForward::Forward, // Treat external as forward/empty for now
    <b:Block> => BlockOrForward::Block(Box::new(b)),
};

Parameters: Vec<Param> = {
    "(" <list:ParamList?> ")" => list.unwrap_or_default(),
};

ParamList: Vec<Param> = {
    <p:ParamSection> => vec![p],
    <mut list:ParamList> ";" <p:ParamSection> => {
        list.push(p);
        list
    }
};

ParamSection: Param = {
    <l:@L> "var" <ids:IdentifierList> ":" <te:TypeExpr> <r:@R> => Spanned { span: Span::new(l, r), node: ParamKind::Variable { is_var: true, ids, type_expr: te } },
    <l:@L> <ids:IdentifierList> ":" <te:TypeExpr> <r:@R> => Spanned { span: Span::new(l, r), node: ParamKind::Variable { is_var: false, ids, type_expr: te } },
    <l:@L> "procedure" <id:"identifier"> <params:Parameters?> <r:@R> => Spanned { span: Span::new(l, r), node: ParamKind::Procedure { id, params } },
    <l:@L> "function" <id:"identifier"> <params:Parameters?> ":" <tn:TypeName> <r:@R> => Spanned { span: Span::new(l, r), node: ParamKind::Function { id, params, return_type: tn } },
};

TypeName: String = {
    "integer" => "integer".to_string(),
    "real" => "real".to_string(),
    "boolean" => "boolean".to_string(),
    "char" => "char".to_string(),
    "string" => "string".to_string(),
    <id:"identifier"> => id,
};

Constant: Expr = {
    <l:@L> <n:"int_lit"> <r:@R> => Spanned { span: Span::new(l, r), node: ExprKind::Integer(n) },
    <l:@L> <n:"real_lit"> <r:@R> => Spanned { span: Span::new(l, r), node: ExprKind::Real(n) },
    <l:@L> <c:"char_lit"> <r:@R> => Spanned { span: Span::new(l, r), node: ExprKind::Char(c) },
    <l:@L> <c:"char_code"> <r:@R> => Spanned { span: Span::new(l, r), node: ExprKind::Char(c) },
    <l:@L> <s:"string_lit"> <r:@R> => Spanned { span: Span::new(l, r), node: ExprKind::String(s) },
    <l:@L> <b:"boolean_lit"> <r:@R> => Spanned { span: Span::new(l, r), node: ExprKind::Boolean(b) },
    <l:@L> <id:"identifier"> <r:@R> => Spanned { 
        span: Span::new(l, r), 
        node: ExprKind::Variable(Box::new(Spanned { span: Span::new(l, r), node: VariableKind::Id(id) })) 
    },
    <l:@L> "+" <id:"identifier"> <r:@R> => {
        let span = Span::new(l, r);
        let v = Spanned { span, node: VariableKind::Id(id) };
        Spanned { span, node: ExprKind::Unary { op: UnaryOp::Plus, expr: Box::new(Spanned { span, node: ExprKind::Variable(Box::new(v)) }) } }
    },
    <l:@L> "-" <id:"identifier"> <r:@R> => {
        let span = Span::new(l, r);
        let v = Spanned { span, node: VariableKind::Id(id) };
        Spanned { span, node: ExprKind::Unary { op: UnaryOp::Minus, expr: Box::new(Spanned { span, node: ExprKind::Variable(Box::new(v)) }) } }
    },
};

TypeExpr: TypeExpr = {
    <l:@L> <tn:TypeName> <r:@R> => Spanned { span: Span::new(l, r), node: TypeExprKind::Simple(tn) },
    <l:@L> "array" "[" <indices:TypeExprList> "]" "of" <et:TypeExpr> <r:@R> => Spanned {
        span: Span::new(l, r),
        node: TypeExprKind::Array {
            indices,
            element_type: Box::new(et),
        }
    },
    <l:@L> "record" <fl:FieldList> "end" <r:@R> => Spanned {
        span: Span::new(l, r),
        node: TypeExprKind::Record {
            fields: fl.0,
            variant_part: fl.1,
        }
    },
    <l:@L> "^" <tn:TypeName> <r:@R> => Spanned {
        span: Span::new(l, r),
        node: TypeExprKind::Pointer(Box::new(Spanned { span: Span::new(l, r), node: TypeExprKind::Simple(tn) }))
    },
    <l:@L> "set" "of" <te:SimpleType> <r:@R> => Spanned { span: Span::new(l, r), node: TypeExprKind::Set(Box::new(te)) },
    <l:@L> "file" "of" <te:TypeExpr> <r:@R> => Spanned { span: Span::new(l, r), node: TypeExprKind::File(Box::new(te)) },
    <l:@L> <start:Constant> ".." <end:Constant> <r:@R> => Spanned { span: Span::new(l, r), node: TypeExprKind::Subrange { start, end } },
    <l:@L> "(" <ids:IdentifierList> ")" <r:@R> => Spanned { span: Span::new(l, r), node: TypeExprKind::Enum(ids) },
    <l:@L> "procedure" <params:Parameters?> <r:@R> => Spanned { span: Span::new(l, r), node: TypeExprKind::Procedure { params } },
    <l:@L> "function" <params:Parameters?> ":" <rt:TypeName> <r:@R> => Spanned { span: Span::new(l, r), node: TypeExprKind::Function { params, return_type: rt } },
};

FieldList: (Vec<VarDecl>, Option<VariantPart>) = {
    <fixed:FixedPart?> <vp:(";" VariantPart)?> ";"? => (fixed.unwrap_or_default(), vp.map(|(_, v)| v)),
    <vp:VariantPart> ";"? => (vec![], Some(vp)),
};

FixedPart: Vec<VarDecl> = {
    <v:VarItem> => vec![v],
    <list:FixedPart> ";" <v:VarItem> => {
        let mut list = list;
        list.push(v);
        list
    },
};

#[inline]
VariantPart: VariantPart = {
    <l:@L> "case" <tag:TagField> <tn:TypeName> "of" <variants:VariantList> <r:@R> => VariantPart {
        span: Span::new(l, r),
        tag_field: tag,
        tag_type: tn,
        variants,
    }
};

#[inline]
TagField: Option<String> = {
    <id:"identifier"> ":" => Some(id),
    () => None,
};

VariantList: Vec<Variant> = {
    <v:Variant> => vec![v],
    <mut list:VariantList> ";" <v:Variant> => {
        list.push(v);
        list
    },
};

Variant: Variant = {
    <l:@L> <labels:CaseLabelList> ":" "(" <fl:FieldList> ")" <r:@R> => Variant {
        span: Span::new(l, r),
        labels,
        fields: fl.0,
        nested_variant: fl.1.map(Box::new),
    }
};

SimpleType: TypeExpr = {
    <l:@L> <tn:TypeName> <r:@R> => Spanned { span: Span::new(l, r), node: TypeExprKind::Simple(tn) },
    <l:@L> <start:Constant> ".." <end:Constant> <r:@R> => Spanned { span: Span::new(l, r), node: TypeExprKind::Subrange { start, end } },
    <l:@L> "(" <ids:IdentifierList> ")" <r:@R> => Spanned { span: Span::new(l, r), node: TypeExprKind::Enum(ids) },
};

TypeExprList: Vec<TypeExpr> = {
    <te:TypeExpr> => vec![te],
    <mut list:TypeExprList> "," <te:TypeExpr> => {
        list.push(te);
        list
    }
};

CompoundStmt: Stmt = {
    <l:@L> "begin" <list:StmtList> "end" <r:@R> => Spanned { span: Span::new(l, r), node: StmtKind::Compound(list) },
};

CompoundStmtInner: Vec<Stmt> = {
    "begin" <list:StmtList> "end" => list,
};

StmtList: Vec<Stmt> = {
    <s:Stmt> => vec![s],
    <mut list:StmtList> ";" <s:OptionalStmt> => {
        list.push(s);
        list
    }
};

OptionalStmt: Stmt = {
    Stmt => <>,
    <l:@L> () <r:@R> => Spanned { span: Span::new(l, r), node: StmtKind::Empty },
};

Stmt: Stmt = {
    MatchedStmt,
    UnmatchedStmt,
};

MatchedStmt: Stmt = {
    <l:@L> <target:Variable> ":=" <val:Expr> <r:@R> => {
        let span = Span::new(l, r);
        let target_span = target.span;
        Spanned { 
            span, 
            node: StmtKind::Assignment { 
                target: Spanned { span: target_span, node: ExprKind::Variable(Box::new(target)) }, 
                value: val 
            } 
        }
    },
    <l:@L> "goto" <n:"int_lit"> <r:@R> => Spanned { span: Span::new(l, r), node: StmtKind::Goto(n) },
    CompoundStmt,
    ProcedureCall,
    <l:@L> "if" <cond:Expr> "then" <ts:MatchedStmt> "else" <es:MatchedStmt> <r:@R> => Spanned { 
        span: Span::new(l, r), 
        node: StmtKind::If { condition: cond, then_stmt: Box::new(ts), else_stmt: Some(Box::new(es)) } 
    },
    <l:@L> "while" <cond:Expr> "do" <body:MatchedStmt> <r:@R> => Spanned { 
        span: Span::new(l, r), 
        node: StmtKind::While { condition: cond, body: Box::new(body) } 
    },
    <l:@L> "repeat" <body:StmtList> "until" <cond:Expr> <r:@R> => Spanned { 
        span: Span::new(l, r), 
        node: StmtKind::Repeat { body, until: cond } 
    },
    <l:@L> "for" <id:"identifier"> ":=" <start:Expr> <to:ForTo> <end:Expr> "do" <body:MatchedStmt> <r:@R> => Spanned { 
        span: Span::new(l, r), 
        node: StmtKind::For { id, start, up: to, end, body: Box::new(body) } 
    },
    <l:@L> "with" <ids:VariableList> "do" <body:MatchedStmt> <r:@R> => Spanned { 
        span: Span::new(l, r), 
        node: StmtKind::With { ids, body: Box::new(body) } 
    },
    <l:@L> <lbl:"int_lit"> ":" <s:MatchedStmt> <r:@R> => Spanned { 
        span: Span::new(l, r), 
        node: StmtKind::Labeled(lbl, Box::new(s)) 
    },
    <l:@L> "case" <expr:Expr> "of" <items:CaseList> <else_stmt:CaseElseOpt> "end" <r:@R> => Spanned { 
        span: Span::new(l, r), 
        node: StmtKind::Case { expr, items, else_stmt: else_stmt.map(Box::new) } 
    },
};

UnmatchedStmt: Stmt = {
    <l:@L> "if" <cond:Expr> "then" <ts:Stmt> <r:@R> => Spanned { 
        span: Span::new(l, r), 
        node: StmtKind::If { condition: cond, then_stmt: Box::new(ts), else_stmt: None } 
    },
    <l:@L> "if" <cond:Expr> "then" <ts:MatchedStmt> "else" <es:UnmatchedStmt> <r:@R> => Spanned { 
        span: Span::new(l, r), 
        node: StmtKind::If { condition: cond, then_stmt: Box::new(ts), else_stmt: Some(Box::new(es)) } 
    },
    <l:@L> "while" <cond:Expr> "do" <body:UnmatchedStmt> <r:@R> => Spanned { 
        span: Span::new(l, r), 
        node: StmtKind::While { condition: cond, body: Box::new(body) } 
    },
    <l:@L> "for" <id:"identifier"> ":=" <start:Expr> <to:ForTo> <end:Expr> "do" <body:UnmatchedStmt> <r:@R> => Spanned { 
        span: Span::new(l, r), 
        node: StmtKind::For { id, start, up: to, end, body: Box::new(body) } 
    },
    <l:@L> "with" <ids:VariableList> "do" <body:UnmatchedStmt> <r:@R> => Spanned { 
        span: Span::new(l, r), 
        node: StmtKind::With { ids, body: Box::new(body) } 
    },
    <l:@L> <lbl:"int_lit"> ":" <s:UnmatchedStmt> <r:@R> => Spanned { 
        span: Span::new(l, r), 
        node: StmtKind::Labeled(lbl, Box::new(s)) 
    },
};

ForTo: bool = {
    "to" => true,
    "downto" => false,
};

CaseList: Vec<CaseItem> = {
    <item:CaseItem> => vec![item],
    <mut list:CaseList> ";" <item:CaseItem> => {
        list.push(item);
        list
    }
};

CaseItem: CaseItem = {
    <l:@L> <labels:CaseLabelList> ":" <stmt:Stmt> <r:@R> => CaseItem { span: Span::new(l, r), labels, stmt },
};

CaseLabelList: Vec<Expr> = {
    <el:CaseLabel> => vec![el],
    <mut list:CaseLabelList> "," <el:CaseLabel> => {
        list.push(el);
        list
    }
};

CaseLabel: Expr = {
    <c:Constant> => c,
    <l:@L> <c1:Constant> ".." <c2:Constant> <r:@R> => Spanned { 
        span: Span::new(l, r), 
        node: ExprKind::Range(Box::new(c1), Box::new(c2)) 
    },
};

CaseElseOpt: Option<Stmt> = {
    ";" "else" <s:Stmt> ";"? => Some(s),
    ";" => None,
    () => None,
};

ProcedureCall: Stmt = {
    <l:@L> <name:BuiltinProc> <r:@R> => Spanned { span: Span::new(l, r), node: StmtKind::ProcedureCall { name, args: None } },
    <l:@L> <name:BuiltinProc> "(" <args:ExprList?> ")" <r:@R> => Spanned { span: Span::new(l, r), node: StmtKind::ProcedureCall { name, args } },
    
    <l:@L> <id:"identifier"> <r:@R> => Spanned { span: Span::new(l, r), node: StmtKind::ProcedureCall { name: id, args: None } },
    <l:@L> <v:Variable> "(" <args:ExprList?> ")" <r:@R> => {
        let span = Span::new(l, r);
        match v.node {
            VariableKind::Id(id) => Spanned { span, node: StmtKind::ProcedureCall { name: id, args } },
            VariableKind::MemberAccess { record, field } => {
                let mut new_args = vec![*record];
                if let Some(mut a) = args {
                    new_args.append(&mut a);
                }
                Spanned { span, node: StmtKind::ProcedureCall { name: field, args: Some(new_args) } }
            },
            _ => panic!("Invalid procedure call target"),
        }
    },
};

VariableList: Vec<Expr> = {
    <v:Variable> => {
        let span = v.span;
        vec![Spanned { span, node: ExprKind::Variable(Box::new(v)) }]
    },
    <mut list:VariableList> "," <v:Variable> => {
        let span = v.span;
        list.push(Spanned { span, node: ExprKind::Variable(Box::new(v)) });
        list
    }
};

Expr: Expr = {
    #[precedence(level="0")]
    PrimaryExpr,
    #[precedence(level="1")]
    <l:@L> "not" <e:Expr> <r:@R> => Spanned { span: Span::new(l, r), node: ExprKind::Unary { op: UnaryOp::Not, expr: Box::new(e) } },
    <l:@L> "+" <e:Expr> <r:@R> => Spanned { span: Span::new(l, r), node: ExprKind::Unary { op: UnaryOp::Plus, expr: Box::new(e) } },
    <l:@L> "-" <e:Expr> <r:@R> => Spanned { span: Span::new(l, r), node: ExprKind::Unary { op: UnaryOp::Minus, expr: Box::new(e) } },
    #[precedence(level="2")] #[assoc(side="left")]
    <l:@L> <l_exp:Expr> "*" <r_exp:Expr> <r:@R> => Spanned { span: Span::new(l, r), node: ExprKind::Binary { op: BinOp::Mul, left: Box::new(l_exp), right: Box::new(r_exp) } },
    <l:@L> <l_exp:Expr> "/" <r_exp:Expr> <r:@R> => Spanned { span: Span::new(l, r), node: ExprKind::Binary { op: BinOp::FloatDiv, left: Box::new(l_exp), right: Box::new(r_exp) } },
    <l:@L> <l_exp:Expr> "div" <r_exp:Expr> <r:@R> => Spanned { span: Span::new(l, r), node: ExprKind::Binary { op: BinOp::Div, left: Box::new(l_exp), right: Box::new(r_exp) } },
    <l:@L> <l_exp:Expr> "mod" <r_exp:Expr> <r:@R> => Spanned { span: Span::new(l, r), node: ExprKind::Binary { op: BinOp::Mod, left: Box::new(l_exp), right: Box::new(r_exp) } },
    <l:@L> <l_exp:Expr> "and" <r_exp:Expr> <r:@R> => Spanned { span: Span::new(l, r), node: ExprKind::Binary { op: BinOp::And, left: Box::new(l_exp), right: Box::new(r_exp) } },
    #[precedence(level="3")] #[assoc(side="left")]
    <l:@L> <l_exp:Expr> "+" <r_exp:Expr> <r:@R> => Spanned { span: Span::new(l, r), node: ExprKind::Binary { op: BinOp::Add, left: Box::new(l_exp), right: Box::new(r_exp) } },
    <l:@L> <l_exp:Expr> "-" <r_exp:Expr> <r:@R> => Spanned { span: Span::new(l, r), node: ExprKind::Binary { op: BinOp::Sub, left: Box::new(l_exp), right: Box::new(r_exp) } },
    <l:@L> <l_exp:Expr> "or" <r_exp:Expr> <r:@R> => Spanned { span: Span::new(l, r), node: ExprKind::Binary { op: BinOp::Or, left: Box::new(l_exp), right: Box::new(r_exp) } },
    #[precedence(level="4")] #[assoc(side="left")]
    <l:@L> <l_exp:Expr> "=" <r_exp:Expr> <r:@R> => Spanned { span: Span::new(l, r), node: ExprKind::Binary { op: BinOp::Eq, left: Box::new(l_exp), right: Box::new(r_exp) } },
    <l:@L> <l_exp:Expr> "<>" <r_exp:Expr> <r:@R> => Spanned { span: Span::new(l, r), node: ExprKind::Binary { op: BinOp::Neq, left: Box::new(l_exp), right: Box::new(r_exp) } },
    <l:@L> <l_exp:Expr> "<" <r_exp:Expr> <r:@R> => Spanned { span: Span::new(l, r), node: ExprKind::Binary { op: BinOp::Lt, left: Box::new(l_exp), right: Box::new(r_exp) } },
    <l:@L> <l_exp:Expr> "<=" <r_exp:Expr> <r:@R> => Spanned { span: Span::new(l, r), node: ExprKind::Binary { op: BinOp::Lte, left: Box::new(l_exp), right: Box::new(r_exp) } },
    <l:@L> <l_exp:Expr> ">" <r_exp:Expr> <r:@R> => Spanned { span: Span::new(l, r), node: ExprKind::Binary { op: BinOp::Gt, left: Box::new(l_exp), right: Box::new(r_exp) } },
    <l:@L> <l_exp:Expr> ">=" <r_exp:Expr> <r:@R> => Spanned { span: Span::new(l, r), node: ExprKind::Binary { op: BinOp::Gte, left: Box::new(l_exp), right: Box::new(r_exp) } },
    <l:@L> <l_exp:Expr> "in" <r_exp:Expr> <r:@R> => Spanned { span: Span::new(l, r), node: ExprKind::Binary { op: BinOp::In, left: Box::new(l_exp), right: Box::new(r_exp) } },
};

PrimaryExpr: Expr = {
    <l:@L> <n:"int_lit"> <r:@R> => Spanned { span: Span::new(l, r), node: ExprKind::Integer(n) },
    <l:@L> <n:"real_lit"> <r:@R> => Spanned { span: Span::new(l, r), node: ExprKind::Real(n) },
    <l:@L> <c:"char_lit"> <r:@R> => Spanned { span: Span::new(l, r), node: ExprKind::Char(c) },
    <l:@L> <c:"char_code"> <r:@R> => Spanned { span: Span::new(l, r), node: ExprKind::Char(c) },
    <l:@L> <s:"string_lit"> <r:@R> => Spanned { span: Span::new(l, r), node: ExprKind::String(s) },
    <l:@L> <b:"boolean_lit"> <r:@R> => Spanned { span: Span::new(l, r), node: ExprKind::Boolean(b) },
    <l:@L> "nil" <r:@R> => Spanned { span: Span::new(l, r), node: ExprKind::Nil },
    <l:@L> "[" <els:ElementList?> "]" <r:@R> => Spanned { span: Span::new(l, r), node: ExprKind::Set(els.unwrap_or_default()) },
    
    // Function calls and UFCS (Method calls desugared to function calls)
    <l:@L> <name:BuiltinFunc> "(" <args:ExprList?> ")" <r:@R> => Spanned { span: Span::new(l, r), node: ExprKind::FunctionCall { name, args } },
    <l:@L> <v:Variable> "(" <args:ExprList?> ")" <r:@R> => {
        let span = Span::new(l, r);
        match v.node {
            VariableKind::Id(id) => Spanned { span, node: ExprKind::FunctionCall { name: id, args } },
            VariableKind::MemberAccess { record, field } => {
                let mut new_args = vec![*record];
                if let Some(mut a) = args {
                    new_args.append(&mut a);
                }
                Spanned { span, node: ExprKind::FunctionCall { name: field, args: Some(new_args) } }
            },
            _ => panic!("Invalid function call target"),
        }
    },
    
    <v:Variable> => {
        let span = v.span;
        Spanned { span, node: ExprKind::Variable(Box::new(v)) }
    },
    "(" <e:Expr> ")" => e,
};

BuiltinFunc: String = {
    "Chr" => "Chr".to_string(),
};

BuiltinProc: String = {
    "write" => "write".to_string(),
    "writeln" => "writeln".to_string(),
    "read" => "read".to_string(),
    "readln" => "readln".to_string(),
};

ElementList: Vec<Element> = {
    <el:Element> => vec![el],
    <mut list:ElementList> "," <el:Element> => {
        list.push(el);
        list
    }
};

Element: Element = {
    <l:@L> <e:Expr> ".." <e2:Expr> <r:@R> => Spanned { span: Span::new(l, r), node: ElementKind::Range(e, e2) },
    <l:@L> <e:Expr> <r:@R> => Spanned { span: Span::new(l, r), node: ElementKind::Single(e) },
};

Variable: Variable = {
    <l:@L> <id:"identifier"> <r:@R> => Spanned { span: Span::new(l, r), node: VariableKind::Id(id) },
    <l:@L> <v:Variable> "." <f:"identifier"> <r:@R> => {
        let span = Span::new(l, r);
        let v_span = v.span;
        Spanned { 
            span, 
            node: VariableKind::MemberAccess { 
                record: Box::new(Spanned { span: v_span, node: ExprKind::Variable(Box::new(v)) }), 
                field: f 
            } 
        }
    },
    <l:@L> <v:Variable> "[" <ids:ExprList> "]" <r:@R> => {
        let span = Span::new(l, r);
        let v_span = v.span;
        Spanned { 
            span, 
            node: VariableKind::ArrayAccess { 
                array: Box::new(Spanned { span: v_span, node: ExprKind::Variable(Box::new(v)) }), 
                indices: ids 
            } 
        }
    },
    <l:@L> <v:Variable> "^" <r:@R> => {
        let span = Span::new(l, r);
        let v_span = v.span;
        Spanned { 
            span, 
            node: VariableKind::PointerDeref(Box::new(Spanned { span: v_span, node: ExprKind::Variable(Box::new(v)) })) 
        }
    },
};

ExprList: Vec<Expr> = {
    <e:Expr> => vec![e],
    <mut list:ExprList> "," <e:Expr> => {
        list.push(e);
        list
    }
};
