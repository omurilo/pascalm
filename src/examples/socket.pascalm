program TestSockets;
var
  s: Socket;
  client: Socket;
  req: HttpRequest;
  res: HttpResponse;
begin
  s := socket_create();
  socket_bind(s, '0.0.0.0', 8080);
  socket_listen(s, 10);
  writeln('Server listening on port 8080...');
  while true do
  begin
    socket_accept(s, client);
    http_read_request(client, req);
    writeln('Method: ', req.method);
    writeln('Path: ', req.path);
    res.status_code := 200;
    res.body := 'Hello from PascalM!';
    http_send_response(client, res);
    socket_close(client);
  end;
end.